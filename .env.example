# Normalerweise erzeugt ./setup.sh diese Datei für dich. Manuell: cp .env.example .env
# Schulname, Administrator-Passwort und QR-Adresse stehen hier NICHT: die legst du beim ersten Aufruf von /admin fest
# (Ersteinrichtung mit Einrichtungscode, siehe docs/INSTALLATION.md) und kannst sie später im Backoffice ändern.

# Passwort der Datenbank (nur intern). In einfache Hochkommas setzen!
# ACHTUNG: Nach dem ersten Start nicht mehr ändern, sonst kommt die App nicht mehr an die Datenbank (siehe README).
DB_PASSWORD='bitte-aendern'

# Geheimer Schlüssel für Anmelde-Cookies: mindestens 32 Zeichen, z. B. erzeugt mit:  openssl rand -hex 32
SECRET_KEY=

# Port, auf dem die App auf diesem Rechner erreichbar ist (bei HTTPS mit Caddy nur lokal)
PORT=8080

# Voreinstellung für die Adresse in den QR-Codes (Wie erreichen die Handys den Server?).
# In der Ersteinrichtung vorausgefüllt, später im Backoffice änderbar.
# Beispiele: http://192.168.1.50:8080   oder   https://wahl.meineschule.at
PUBLIC_URL=http://localhost:8080

TZ=Europe/Vienna

# Anzahl der App-Prozesse (1 pro CPU-Kern, 2 reichen für 1000 Schüler)
WEB_CONCURRENCY=2

# Nur mit HTTPS (Caddy bzw. Reverse-Proxy):
# TRUST_PROXY=1
# COOKIE_SECURE=1
# APP_BIND=127.0.0.1
# COMPOSE_PROFILES=https

# Nur für automatische Installationen/Tests (sonst nicht setzen): legt den Benutzer "admin" sofort mit diesem Passwort an
# und überspringt die Ersteinrichtung im Browser.
# ADMIN_PASSWORD='...'
