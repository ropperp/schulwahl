# Normalerweise erzeugt ./setup.sh diese Datei für dich. Manuell: cp .env.example .env

# Passwort für das Backoffice (/admin) - LANG und ZUFÄLLIG wählen. In einfache Hochkommas setzen!
ADMIN_PASSWORD='bitte-aendern'

# Passwort der Datenbank (nur intern). ACHTUNG: Nach dem ersten Start nicht mehr ändern,
# sonst kommt die App nicht mehr an die Datenbank (siehe README).
DB_PASSWORD='bitte-auch-aendern'

# Geheimer Schlüssel für Admin-Sitzungen (z. B. mit: openssl rand -hex 32)
SECRET_KEY=

# Wie die Handys den Server erreichen; wird in die QR-Codes geschrieben.
# Beispiele: http://192.168.1.50:8080   oder   https://wahl.meineschule.at
PUBLIC_URL=http://localhost:8080

SCHOOL_NAME='Unsere Schule'
PORT=8080
TZ=Europe/Vienna

# Nur mit HTTPS (Caddy):
# TRUST_PROXY=1
# COOKIE_SECURE=1
# APP_BIND=127.0.0.1
# COMPOSE_PROFILES=https
