# Kopieren nach .env und Werte anpassen:   cp .env.example .env

# Passwort für den Admin-Zugang (Backoffice unter /admin) - LANG und ZUFÄLLIG wählen!
ADMIN_PASSWORD=bitte-aendern

# Passwort der Datenbank (nur intern genutzt)
DB_PASSWORD=bitte-auch-aendern

# Geheimer Schlüssel für Admin-Sitzungen (z. B. mit: openssl rand -hex 32)
SECRET_KEY=

# Wie die Handys den Server erreichen. Wird in die QR-Codes auf den Zetteln geschrieben.
# Beispiele: http://192.168.1.50:8080   oder   https://wahl.meineschule.at
PUBLIC_URL=http://localhost:8080

SCHOOL_NAME=Unsere Schule
PORT=8080
TZ=Europe/Vienna

# Nur mit HTTPS-Proxy (Caddy):
# TRUST_PROXY=1
# COOKIE_SECURE=1
# SITE_ADDRESS=localhost
